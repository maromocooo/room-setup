# Copy this file to .env and fill in the engines you have installed.
# Each engine runs in its own Python environment; point *_PYTHON at that
# environment's interpreter and *_ROOT at the upstream repository checkout.
# Engines left blank show up as "not set up" in the app.

# Hunyuan3D 2.1 — https://github.com/Tencent-Hunyuan/Hunyuan3D-2.1
HUNYUAN3D_PYTHON=
HUNYUAN3D_ROOT=

# TRELLIS.2 — https://github.com/microsoft/TRELLIS.2
TRELLIS2_PYTHON=
TRELLIS2_ROOT=

# TRELLIS — https://github.com/microsoft/TRELLIS
TRELLIS_PYTHON=
TRELLIS_ROOT=

# Pixal3D — https://github.com/TencentARC/Pixal3D (TRELLIS.2 environment + its extras)
PIXAL3D_PYTHON=
PIXAL3D_ROOT=
# PIXAL3D_RESOLUTION=1024   # or 1536 (slower, more detail)
# PIXAL3D_LOW_VRAM=0        # load everything on the GPU (faster; needs >20 GB free)

# SAM 3D Objects — https://github.com/facebookresearch/sam-3d-objects
# Weights go in SAM3D_ROOT/checkpoints/hf (gated on Hugging Face; see docs/engines.md).
SAM3D_PYTHON=
SAM3D_ROOT=

# Engine selected when the app opens, and one to load as soon as the API starts.
DEFAULT_ENGINE=hunyuan3d
# PRELOAD_ENGINE=hunyuan3d

# Box-shaped stand-in engine for trying the app without a GPU.
# ROOM_SETUP_MOCK_ENGINE=1

# Gateway address (Vite forwards /api and /generated here).
API_HOST=127.0.0.1
API_PORT=8001
# GENERATED_DIR=./generated
# LOG_DIR=./logs

# Web app address. Use HOST=0.0.0.0 only on a network you trust: the app
# and API have no authentication.
# HOST=127.0.0.1
# PORT=5173

# The API only answers requests addressed to localhost or an IP address. If you
# open the app through a host name on your LAN, list it here (comma-separated).
# ALLOWED_HOSTS=my-pc.local

# Pin engine workers to these CPUs (Linux) if model loading crashes at random.
# ENGINE_CPUSET=16-31

# Give up on a generation job after this many seconds (default 1800).
# JOB_TIMEOUT=1800
