{
  "name": "room-setup",
  "version": "1.0.0",
  "description": "Plan a room in 2D, walk it in 3D, and fill it with furniture generated from photos.",
  "license": "MIT",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "api": "bash scripts/start-api.sh",
    "mcp": ".venv/bin/python server/mcp_server.py",
    "test": "node --test \"tests/**/*.test.js\"",
    "test:api": ".venv/bin/python -m pytest -q tests",
    "test:ui": "node tests/ui-smoke.mjs"
  },
  "dependencies": {
    "earcut": "^3.0.2",
    "jszip": "^3.10.1",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "puppeteer-core": "^25.12.0",
    "vite": "^8.3.4"
  }
}
